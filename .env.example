# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Database the agent reads. SQLite (local) or Postgres (docker compose sets this for you).
DATABASE_URL=sqlite:///data/demo/chinook.sqlite
# DATABASE_URL=postgresql://analyst_ro:analyst_ro@localhost:5432/chinook

MODEL=claude-sonnet-5-5   # or claude-haiku-5-5: ~9x cheaper, 18 pp less accurate on BIRD
EFFORT=medium
SPEND_CAP_USD=5.00
ROW_LIMIT=500
STATEMENT_TIMEOUT_MS=5000
MAX_ATTEMPTS=3
CLARIFY=true
LLM_CACHE=true
LOG_LEVEL=INFO
